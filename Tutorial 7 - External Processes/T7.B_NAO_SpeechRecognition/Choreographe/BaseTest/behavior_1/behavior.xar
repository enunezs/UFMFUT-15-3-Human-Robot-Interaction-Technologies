            <Box name="Test" id="1" localization="8" tooltip="" x="368" y="115">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4">
                <content>
                  <![CDATA[#----------------------------------------------------------------------------------#
# By Emanuel Nunez and Edward White, updated by Paul Bremner
# Version 1.2s
#----------------------------------------------------------------------------------#
# Original from https://github.com/PaulBremner/Choregraphe/tree/master
#----------------------------------------------------------------------------------#
# Notes
# - Set the host IP address to the IP address of the computer running the server.
# - This address may change between sessimsgs_log.
# - Use ipconfig (Windows) or ip addr / ifconfig (Linux) to find the IP address.
# - The robot must be able to reach the computer over the network.
# - The port number must match the server.
#----------------------------------------------------------------------------------#
# Usage
# 1. Paste this code into a Python box in Choregraphe.
# 2. Change the output type of onAnswer to String.
# 3. Run the NLP server code on the computer.
# 4. Run the behaviour in Choregraphe.
#----------------------------------------------------------------------------------#

# Import the necessary modules (yes, even inside of Choregraphe)
import socket
import time

# Parameters for the server
# host = '169.254.55.109'  # Replace with your computer's IP address
host = '127.0.0.1'   # Localhost, if the simulated robot and server share the same host

port = 8889 # No need to change


class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)
        self.client_socket = None
        self.running = False ### NEW, track running in a loop

    def onLoad(self):
        # Called when "play" is pressed
        pass

    def onInput_onStart(self):

        self.running = True
        # Repeat the speech recognition request until stopped
        while self.running:

            try:

                ### 1. Set up the client socket

                # Create a TCP/IP socket
                self.logger.info("Connecting to socket...")
                self.client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

                ### 2. Connect to the server

                self.logger.info("Connecting to server...")
                self.client_socket.connect((host, port))

                ### 3. Send a message

                # Sending "1" tells the server to start speech recognition
                important_message = "1"

                self.logger.info("Sending: " + important_message)

                # Convert the message into bytes and send it
                self.client_socket.sendall(important_message.encode())

                ### 4. Receive the answer

                # Wait for the server to finish speech recognition
                # Receive up to 1024 bytes and convert them into a string
                important_answer = self.client_socket.recv(1024).decode()

                self.logger.info("Received: " + str(important_answer))
                self.onAnswer(str(important_answer))

                # Logging the answer
                msgs_log = ""
                msgs_log += important_answer

                # Show the logged information
                self.logger.info("Complete message log: " + str(msgs_log))

                # NEW: Stop the loop if the server disconnects
                if not important_answer:
                    self.running = False

            except socket.error as error:
                self.logger.error("Communication error: " + str(error))
                important_answer = "Error"
                self.running = False ### Dont forget resetting

            finally:

                ### 5. Close the connection
                self.close_socket()


            ### 6. Repeat the process

            # Small pause before requesting speech recognition again
            time.sleep(0.1)

            # Go back to Step 1


    def onInput_onStop(self):
        self.onUnload()
        self.onStopped()


    def onUnload(self):
        self.running = False
        # Close the socket when stopped
        if self.client_socket is not None:

            # Interrupt any pending communication
            try:
                self.client_socket.shutdown(socket.SHUT_RDWR)
            except socket.error:
                pass

            self.client_socket.close()
            self.client_socket = None

    def close_socket(self):

        # Close the socket if one has been created
        if self.client_socket is not None:

            # Interrupt any pending communication
            try:
                self.client_socket.shutdown(socket.SHUT_RDWR)
            except socket.error:
                pass

            self.client_socket.close()
            self.client_socket = None]]>
                </content>
              </script>
